<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.8.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CSweet.Agent.SDK" Version="3.11.1" Condition="'$(UseLocalCSweetAgentSdk)' != 'true'" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.15.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalCSweetAgentSdk)' == 'true'">
    <ProjectReference Include="$(CSweetAgentSdkRepositoryRoot)\src\CSweet.Agent.SDK\CSweet.Agent.SDK.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\csweet-plugin.json"
             Link="csweet-plugin.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
