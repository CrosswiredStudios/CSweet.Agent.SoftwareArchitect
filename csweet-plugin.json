{
  "$schema": "https://raw.githubusercontent.com/CrosswiredStudios/CSweetAgentSdk/main/schemas/csweet-plugin.v2.schema.json",
  "manifestVersion": "2.0",
  "kind": "agent",
  "id": "com.csweet.software-architect",
  "name": "C-Sweet Software Architect",
  "version": "0.3.2",
  "publisher": {
    "id": "com.csweet",
    "name": "C-Sweet"
  },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/CSweet.Agents.SoftwareArchitect/CSweet.Agents.SoftwareArchitect.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "AlwaysOn",
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1,
    "workspaceAccess": "None"
  },
  "protocol": {
    "minimumVersion": "2.0",
    "maximumVersion": "2.x"
  },
  "provides": [
    {
      "name": "assistant.converse.v1",
      "description": "Converse with the Software Architect about system design and delivery tradeoffs.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerProfileId", "conversationId", "prompt"],
        "properties": {
          "providerProfileId": { "type": "string", "format": "uuid" },
          "conversationId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "context": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          },
          "userId": { "type": ["string", "null"] },
          "messageId": { "type": "string", "format": "uuid" },
          "chatTurnId": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversationId", "response", "proposedActions", "createdAt"],
        "properties": {
          "conversationId": { "type": "string" },
          "response": { "type": "string" },
          "proposedActions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionType", "summary", "parametersJson", "requiresApproval"],
              "properties": {
                "actionType": { "type": "string" },
                "summary": { "type": "string" },
                "parametersJson": { "type": "string" },
                "requiresApproval": { "type": "boolean" }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 120,
      "idempotency": "work-item"
    },
    {
      "name": "assistant.summarize-activity.v1",
      "description": "Summarize architecture activity, decisions, risks, and delivery readiness.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerProfileId", "conversationId", "prompt"],
        "properties": {
          "providerProfileId": { "type": "string", "format": "uuid" },
          "conversationId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "context": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          },
          "userId": { "type": ["string", "null"] },
          "messageId": { "type": "string", "format": "uuid" },
          "chatTurnId": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversationId", "response", "proposedActions", "createdAt"],
        "properties": {
          "conversationId": { "type": "string" },
          "response": { "type": "string" },
          "proposedActions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionType", "summary", "parametersJson", "requiresApproval"],
              "properties": {
                "actionType": { "type": "string" },
                "summary": { "type": "string" },
                "parametersJson": { "type": "string" },
                "requiresApproval": { "type": "boolean" }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 120,
      "idempotency": "work-item"
    },
    {
      "name": "assistant.plan-work.v1",
      "description": "Discuss architecture planning without publishing board mutations.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerProfileId", "conversationId", "prompt"],
        "properties": {
          "providerProfileId": { "type": "string", "format": "uuid" },
          "conversationId": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "context": {
            "type": ["object", "null"],
            "additionalProperties": { "type": "string" }
          },
          "userId": { "type": ["string", "null"] },
          "messageId": { "type": "string", "format": "uuid" },
          "chatTurnId": { "type": "string", "format": "uuid" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conversationId", "response", "proposedActions", "createdAt"],
        "properties": {
          "conversationId": { "type": "string" },
          "response": { "type": "string" },
          "proposedActions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionType", "summary", "parametersJson", "requiresApproval"],
              "properties": {
                "actionType": { "type": "string" },
                "summary": { "type": "string" },
                "parametersJson": { "type": "string" },
                "requiresApproval": { "type": "boolean" }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 120,
      "idempotency": "work-item"
    },
    {
      "name": "software-architecture.design.v1",
      "description": "Create a typed, read-only system design and incremental implementation plan.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boardId", "productGoal", "requirements", "acceptanceCriteria", "idempotencyKey"
        ],
        "properties": {
          "boardId": { "type": "string", "format": "uuid" },
          "productGoal": { "type": "string", "minLength": 1, "maxLength": 8000 },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
          },
          "constraints": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
          },
          "nonGoals": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
          },
          "qualityAttributes": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
          },
          "desiredStartAt": { "type": ["string", "null"], "format": "date-time" },
          "sprintLengthDays": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 30
          },
          "sourceConversationId": { "type": ["string", "null"], "format": "uuid" },
          "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planId", "planHash", "boardId", "productGoal", "plan", "preparedAt"],
        "properties": {
          "planId": { "type": "string", "format": "uuid" },
          "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "boardId": { "type": "string", "format": "uuid" },
          "productGoal": { "type": "string" },
          "plan": { "$ref": "#/$defs/architecturePlan" },
          "preparedAt": { "type": "string", "format": "date-time" }
        },
        "$defs": {
          "stringArray": {
            "type": "array",
            "items": { "type": "string" }
          },
          "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name", "responsibility", "dependencies", "dependencyDirection", "exposedInterfaces"
            ],
            "properties": {
              "name": { "type": "string" },
              "responsibility": { "type": "string" },
              "dependencies": { "$ref": "#/$defs/stringArray" },
              "dependencyDirection": { "type": "string" },
              "exposedInterfaces": { "$ref": "#/$defs/stringArray" }
            }
          },
          "interface": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "provider", "consumer", "contract", "failureBehavior"],
            "properties": {
              "name": { "type": "string" },
              "provider": { "type": "string" },
              "consumer": { "type": "string" },
              "contract": { "type": "string" },
              "failureBehavior": { "type": "string" }
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "decision", "rationale", "alternatives", "consequences"],
            "properties": {
              "title": { "type": "string" },
              "decision": { "type": "string" },
              "rationale": { "type": "string" },
              "alternatives": { "$ref": "#/$defs/stringArray" },
              "consequences": { "$ref": "#/$defs/stringArray" }
            }
          },
          "qualityAttribute": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "scenario", "strategy", "verification"],
            "properties": {
              "name": { "type": "string" },
              "scenario": { "type": "string" },
              "strategy": { "type": "string" },
              "verification": { "type": "string" }
            }
          },
          "trace": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement", "componentNames", "ticketKeys"],
            "properties": {
              "requirement": { "type": "string" },
              "componentNames": { "$ref": "#/$defs/stringArray" },
              "ticketKeys": { "$ref": "#/$defs/stringArray" }
            }
          },
          "ticket": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key", "title", "kind", "priority", "objective", "context", "requirements",
              "acceptanceCriteria", "constraints", "interfaceAndDataChanges",
              "implementationGuidance", "tests", "dependencies", "migrationAndRollback",
              "estimatePoints"
            ],
            "properties": {
              "key": { "type": "string" },
              "title": { "type": "string" },
              "kind": { "enum": ["Story", "Task"] },
              "priority": { "enum": ["Low", "Medium", "High", "Critical"] },
              "objective": { "type": "string" },
              "context": { "type": "string" },
              "requirements": { "$ref": "#/$defs/stringArray" },
              "acceptanceCriteria": { "$ref": "#/$defs/stringArray" },
              "constraints": { "$ref": "#/$defs/stringArray" },
              "interfaceAndDataChanges": { "$ref": "#/$defs/stringArray" },
              "implementationGuidance": { "$ref": "#/$defs/stringArray" },
              "tests": { "$ref": "#/$defs/stringArray" },
              "dependencies": { "$ref": "#/$defs/stringArray" },
              "migrationAndRollback": { "type": "string" },
              "estimatePoints": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
            }
          },
          "sprint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "name", "goal", "startsAt", "endsAt", "tickets"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 1 },
              "name": { "type": "string" },
              "goal": { "type": "string" },
              "startsAt": { "type": ["string", "null"], "format": "date-time" },
              "endsAt": { "type": ["string", "null"], "format": "date-time" },
              "tickets": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/ticket" }
              }
            }
          },
          "architecturePlan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary", "systemContext", "components", "interfaces", "dataFlows",
              "decisions", "qualityAttributes", "failureModes", "migrationPlan",
              "rolloutPlan", "rollbackPlan", "risks", "assumptions", "blockingQuestions",
              "requirementTraceability", "sprints"
            ],
            "properties": {
              "summary": { "type": "string" },
              "systemContext": { "type": "string" },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/component" }
              },
              "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
              "dataFlows": { "$ref": "#/$defs/stringArray" },
              "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
              "qualityAttributes": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/qualityAttribute" }
              },
              "failureModes": { "$ref": "#/$defs/stringArray" },
              "migrationPlan": { "type": "string" },
              "rolloutPlan": { "type": "string" },
              "rollbackPlan": { "type": "string" },
              "risks": { "$ref": "#/$defs/stringArray" },
              "assumptions": { "$ref": "#/$defs/stringArray" },
              "blockingQuestions": { "$ref": "#/$defs/stringArray" },
              "requirementTraceability": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/trace" }
              },
              "sprints": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/sprint" }
              }
            }
          }
        }
      },
      "executionTimeoutSeconds": 300,
      "idempotency": "caller-key"
    },
    {
      "name": "software-architecture.publish-plan.v1",
      "description": "Publish an explicitly approved architecture plan as planned sprints and developer-ready work.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boardId", "design", "approval", "idempotencyKey",
          "repositoryConnectionId", "baseBranch", "firstSprintSequence",
          "accountableOrganizationUserId", "developerInstallationId", "qualityInstallationId"
        ],
        "properties": {
          "boardId": { "type": "string", "format": "uuid" },
          "repositoryConnectionId": { "type": "string", "format": "uuid" },
          "baseBranch": { "type": "string", "minLength": 1, "maxLength": 256 },
          "firstSprintSequence": { "type": "integer", "minimum": 1 },
          "accountableOrganizationUserId": { "type": "string", "format": "uuid" },
          "developerInstallationId": { "type": "string", "format": "uuid" },
          "qualityInstallationId": { "type": "string", "format": "uuid" },
          "design": {
            "type": "object",
            "additionalProperties": false,
            "required": ["planId", "planHash", "boardId", "productGoal", "plan", "preparedAt"],
            "properties": {
              "planId": { "type": "string", "format": "uuid" },
              "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "boardId": { "type": "string", "format": "uuid" },
              "productGoal": { "type": "string" },
              "plan": { "$ref": "#/$defs/architecturePlan" },
              "preparedAt": { "type": "string", "format": "date-time" }
            }
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approverRole", "rationale", "approvedAt"],
            "properties": {
              "approverRole": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "approvedAt": { "type": "string", "format": "date-time" },
              "sourceConversationId": { "type": ["string", "null"], "format": "uuid" },
              "sourceMessageId": { "type": ["string", "null"], "format": "uuid" }
            }
          },
          "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "$defs": {
          "stringArray": { "type": "array", "items": { "type": "string" } },
          "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name", "responsibility", "dependencies", "dependencyDirection", "exposedInterfaces"
            ],
            "properties": {
              "name": { "type": "string" },
              "responsibility": { "type": "string" },
              "dependencies": { "$ref": "#/$defs/stringArray" },
              "dependencyDirection": { "type": "string" },
              "exposedInterfaces": { "$ref": "#/$defs/stringArray" }
            }
          },
          "interface": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "provider", "consumer", "contract", "failureBehavior"],
            "properties": {
              "name": { "type": "string" },
              "provider": { "type": "string" },
              "consumer": { "type": "string" },
              "contract": { "type": "string" },
              "failureBehavior": { "type": "string" }
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "decision", "rationale", "alternatives", "consequences"],
            "properties": {
              "title": { "type": "string" },
              "decision": { "type": "string" },
              "rationale": { "type": "string" },
              "alternatives": { "$ref": "#/$defs/stringArray" },
              "consequences": { "$ref": "#/$defs/stringArray" }
            }
          },
          "qualityAttribute": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "scenario", "strategy", "verification"],
            "properties": {
              "name": { "type": "string" },
              "scenario": { "type": "string" },
              "strategy": { "type": "string" },
              "verification": { "type": "string" }
            }
          },
          "trace": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement", "componentNames", "ticketKeys"],
            "properties": {
              "requirement": { "type": "string" },
              "componentNames": { "$ref": "#/$defs/stringArray" },
              "ticketKeys": { "$ref": "#/$defs/stringArray" }
            }
          },
          "ticket": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key", "title", "kind", "priority", "objective", "context", "requirements",
              "acceptanceCriteria", "constraints", "interfaceAndDataChanges",
              "implementationGuidance", "tests", "dependencies", "migrationAndRollback",
              "estimatePoints"
            ],
            "properties": {
              "key": { "type": "string" },
              "title": { "type": "string" },
              "kind": { "enum": ["Story", "Task"] },
              "priority": { "enum": ["Low", "Medium", "High", "Critical"] },
              "objective": { "type": "string" },
              "context": { "type": "string" },
              "requirements": { "$ref": "#/$defs/stringArray" },
              "acceptanceCriteria": { "$ref": "#/$defs/stringArray" },
              "constraints": { "$ref": "#/$defs/stringArray" },
              "interfaceAndDataChanges": { "$ref": "#/$defs/stringArray" },
              "implementationGuidance": { "$ref": "#/$defs/stringArray" },
              "tests": { "$ref": "#/$defs/stringArray" },
              "dependencies": { "$ref": "#/$defs/stringArray" },
              "migrationAndRollback": { "type": "string" },
              "estimatePoints": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
            }
          },
          "sprint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "name", "goal", "startsAt", "endsAt", "tickets"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 1 },
              "name": { "type": "string" },
              "goal": { "type": "string" },
              "startsAt": { "type": ["string", "null"], "format": "date-time" },
              "endsAt": { "type": ["string", "null"], "format": "date-time" },
              "tickets": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/ticket" }
              }
            }
          },
          "architecturePlan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "summary", "systemContext", "components", "interfaces", "dataFlows",
              "decisions", "qualityAttributes", "failureModes", "migrationPlan",
              "rolloutPlan", "rollbackPlan", "risks", "assumptions", "blockingQuestions",
              "requirementTraceability", "sprints"
            ],
            "properties": {
              "summary": { "type": "string" },
              "systemContext": { "type": "string" },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/component" }
              },
              "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
              "dataFlows": { "$ref": "#/$defs/stringArray" },
              "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
              "qualityAttributes": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/qualityAttribute" }
              },
              "failureModes": { "$ref": "#/$defs/stringArray" },
              "migrationPlan": { "type": "string" },
              "rolloutPlan": { "type": "string" },
              "rollbackPlan": { "type": "string" },
              "risks": { "$ref": "#/$defs/stringArray" },
              "assumptions": { "$ref": "#/$defs/stringArray" },
              "blockingQuestions": { "$ref": "#/$defs/stringArray" },
              "requirementTraceability": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/trace" }
              },
              "sprints": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/sprint" }
              }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["planId", "epicId", "sprints", "tickets", "publishedAt"],
        "properties": {
          "planId": { "type": "string", "format": "uuid" },
          "epicId": { "type": "string", "format": "uuid" },
          "sprints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ordinal", "sprintId", "name"],
              "properties": {
                "ordinal": { "type": "integer" },
                "sprintId": { "type": "string", "format": "uuid" },
                "name": { "type": "string" }
              }
            }
          },
          "tickets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "itemId", "sprintId", "kind"],
              "properties": {
                "key": { "type": "string" },
                "itemId": { "type": "string", "format": "uuid" },
                "sprintId": { "type": "string", "format": "uuid" },
                "kind": { "type": "string" }
              }
            }
          },
          "publishedAt": { "type": "string", "format": "date-time" }
        }
      },
      "executionTimeoutSeconds": 180,
      "idempotency": "caller-key",
      "riskClass": "sensitive"
    },
    {
      "name": "agent.configuration.describe.v1",
      "description": "Describe Software Architect installation configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "agentVersion", "schemaVersion", "fields", "settings"],
        "properties": {
          "agentId": { "type": "string" },
          "agentVersion": { "type": "string" },
          "schemaVersion": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "object" } },
          "settings": { "type": "object" }
        }
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "none"
    },
    {
      "name": "agent.configuration.update.v1",
      "description": "Update Software Architect installation configuration.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["settings"],
        "properties": {
          "settings": { "type": "object" }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "schemaVersion", "settings", "updatedAt"],
        "properties": {
